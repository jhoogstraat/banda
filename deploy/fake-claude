#!/bin/bash
# Fake Claude Code for tests: logged in unless `auth logout` ran, and emits
# stream-json turns like the real CLI, creating one file per prompt (holding
# the prompt's stream-json line). Replies name the --model and --effort it was
# started with. A prompt that mentions "preview" starts a web server on :5173
# instead (the Browser tab). One that says "commit" also commits. "e2e-ask"
# runs a Bash command (its description holds $E2E_SECRET, for redaction) that
# asks for permission first (unless the mode bypasses), "e2e-plan" proposes a
# plan in plan mode (ExitPlanMode); both act on the answer.
#
# Directives a test puts anywhere in a prompt, one case each in the loop below
# (web/e2e/fixtures.ts has helpers for them):
#   e2e-echo          first says "Received: <the prompt's text>", so tests read
#                     what reached the agent from the events.
#   e2e-hold:<name>   starts the turn (init, a delta, "Holding <name>", a Bash
#                     tool call) and keeps it open until ~/e2e-release/<name>
#                     exists, then goes on with the prompt. It keeps reading
#                     stdin: messages queue, permission modes apply, and an
#                     interrupt ends the turn.
#   e2e-fold          on a held turn: the messages that arrived while it was
#                     held join the turn (each says "Folded a message into this
#                     turn", and with e2e-echo "Received: …"), and only one
#                     result follows, like the real CLI folding at a tool boundary.
#   e2e-crash:<name>  makes a tool call and exits 1 mid-turn, without a result,
#                     once per thread: a redelivered prompt runs normally.
#   e2e-cost:<usd>    the turn's result reports this total_cost_usd (default 0.01).
#   e2e-noop          replies and ends the turn, changing no file.
#   e2e-mcp:<tool>:<base64 JSON arguments>
#                     calls that tool of the Banda MCP server, as the agent
#                     would, and says "MCP <tool>: <result text>".
# An interrupt gets a result only while a turn runs (a hold), like the real CLI.
# Before each result it reads what was sent meanwhile, as the real CLI reads stdin
# during a turn, and reports the prompts still waiting as queued_turn_count.
if [ "$1" = auth ]; then
  out="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.fake-logged-out"
  case "$2" in
    status) [ ! -e "$out" ] ;;
    login) echo "Open https://claude.ai/fake-login to sign in."; rm -f "$out"; echo "Login successful." ;;
    logout) touch "$out" && echo "Successfully logged out." ;;
  esac
  exit
fi
model=default effort=default
while [ $# -gt 0 ]; do
  case "$1" in
    --model) model=$2; shift ;;
    --effort) effort=$2; shift ;;
  esac
  shift
done
mode=default
# The runner marshals maps, so keys are sorted: "request" comes before "type".
setmode() { mode=$(sed 's/.*"mode":"\([A-Za-z]*\)".*/\1/' <<<"$1"); }
# ask <tool> <tool_use id> <input json>: asks like --permission-prompt-tool stdio
# and leaves the answer's control_response line in $answer.
ask() {
  local id=perm-$RANDOM$RANDOM
  echo "{\"type\":\"control_request\",\"request_id\":\"$id\",\"request\":{\"subtype\":\"can_use_tool\",\"tool_name\":\"$1\",\"input\":$3,\"tool_use_id\":\"$2\",\"description\":\"fake asks\"}}"
  while IFS= read -r answer; do
    case "$answer" in
      *set_permission_mode*) setmode "$answer" ;;
      *control_response*) [[ $answer == *"\"$id\""* ]] && return ;;
    esac
  done
}
# tool <id> <name> <input json> <output>: a tool call and its result, after asking if needed.
tool() {
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"$1\",\"name\":\"$2\",\"input\":$3}]},\"parent_tool_use_id\":null}"
  answer='"behavior":"allow"'
  [ "$mode" = bypassPermissions ] || ask "$2" "$1" "$3"
  if [[ $answer == *'"behavior":"allow"'* ]]; then
    ok=1 err=false out=$4
  else
    ok='' err=true out=$(sed 's/.*"message":"\([^"]*\)".*/\1/' <<<"$answer")
  fi
  echo "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"$1\",\"type\":\"tool_result\",\"content\":\"$out\",\"is_error\":$err}]},\"parent_tool_use_id\":null}"
}
say() {
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"$1\"}]},\"parent_tool_use_id\":null}"
  queued
  echo '{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":10,"total_cost_usd":0,"queued_turn_count":'$nq'}'
}
# ack <control_request line>: a success control_response to it.
ack() { echo "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p' <<<"$1")\"}}"; }
interrupted() { queued; echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"interrupted","duration_ms":1,"queued_turn_count":'$nq'}'; }
text() { jq -cn --arg t "$1" '{type:"assistant",message:{content:[{type:"text",text:$t}]},parent_tool_use_id:null}'; }
result() { queued; echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"done\",\"duration_ms\":10,\"total_cost_usd\":$cost,\"queued_turn_count\":$nq}"; }
# prompt <user line>: its text.
prompt() { jq -r '.message.content | if type == "string" then . else map(select(.type == "text").text) | join("\n") end' <<<"$1"; }
queue=()
# next: the next line, from the messages queued during a turn first.
next() {
  if [ ${#queue[@]} -gt 0 ]; then line=${queue[0]}; queue=("${queue[@]:1}"); else IFS= read -r line; fi
}
# queued: moves the lines sent so far into the queue and sets $nq to the
# prompts among them, a result's queued_turn_count.
queued() {
  local l rest s
  while :; do
    IFS= read -r -t 0.05 l; s=$?
    if [ $s = 0 ]; then queue+=("$l")
    elif [ $s -gt 128 ] && [ -n "$l" ] && IFS= read -r rest; then queue+=("$l$rest") # a line cut by the timeout
    else break; fi
  done
  nq=0
  for l in "${queue[@]}"; do [[ $l == *'"type":"user"'* ]] && nq=$((nq + 1)); done
}
# hold <name> [fold]: see e2e-hold and e2e-fold above. Fails if interrupted.
hold() {
  local l part= id=toolu_hold_$1
  echo "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"s\",\"model\":\"$model\"}"
  echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Holding"}},"parent_tool_use_id":null}'
  text "Holding $1"
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"$id\",\"name\":\"Bash\",\"input\":{\"command\":\"wait for $1\"}}]},\"parent_tool_use_id\":null}"
  until [ -e ~/e2e-release/"$1" ]; do
    IFS= read -r -t 0.2 l
    case $? in
      0) l=$part$l part= ;;
      1) exit 0 ;; # stdin closed
      *) part+=$l; continue ;; # a timeout keeps what was read of the line
    esac
    case "$l" in
      *'"subtype":"interrupt"'*)
        ack "$l"
        echo "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"$id\",\"type\":\"tool_result\",\"content\":\"interrupted\",\"is_error\":true}]},\"parent_tool_use_id\":null}"
        interrupted; return 1 ;;
      *set_permission_mode*) setmode "$l" ;;
      *control_re*) ;;
      *) queue+=("$l") ;;
    esac
  done
  echo "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"$id\",\"type\":\"tool_result\",\"content\":\"released\",\"is_error\":false}]},\"parent_tool_use_id\":null}"
  [ -n "$2" ] || return 0
  queued
  local q kept=()
  for q in "${queue[@]}"; do
    if [[ $q == *'"type":"user"'* ]]; then
      [[ $q == *e2e-echo* ]] && text "Received: $(prompt "$q")"
      text "Folded a message into this turn"
    else
      kept+=("$q")
    fi
  done
  queue=("${kept[@]}")
}
# mcp <tool> <base64 arguments>: see e2e-mcp above.
mcp() {
  local args out id=toolu_mcp$RANDOM
  args=$(base64 -d <<<"$2")
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"$id\",\"name\":\"mcp__banda__$1\",\"input\":$args}]},\"parent_tool_use_id\":null}"
  out=$(curl -s -X POST "$BANDA_API_URL/mcp" -H "Authorization: Bearer $BANDA_RUNNER_TOKEN" -H "X-Banda-Thread: $BANDA_THREAD_ID" \
    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
    -d "$(jq -cn --arg n "$1" --argjson a "$args" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$n,arguments:$a}}')" |
    sed -n 's/^data: //; /^{/p' | jq -r '.result.content[0].text // .error.message // .')
  jq -cn --arg id "$id" --arg out "$out" '{type:"user",message:{role:"user",content:[{tool_use_id:$id,type:"tool_result",content:$out,is_error:false}]},parent_tool_use_id:null}'
  text "MCP $1: $out"
}
while next; do
  cost=0.01
  if [[ $line == *'"type":"user"'* ]]; then
    [[ $line =~ e2e-cost:([0-9.]+) ]] && cost=${BASH_REMATCH[1]}
    if [[ $line == *e2e-echo* ]]; then
      text "Received: $(prompt "$line")"
    fi
    if [[ $line =~ e2e-crash:([A-Za-z0-9_-]+) ]] && [ ! -e ~/e2e-crashed/"${BASH_REMATCH[1]}" ]; then
      mkdir -p ~/e2e-crashed && touch ~/e2e-crashed/"${BASH_REMATCH[1]}"
      echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_crash","name":"Bash","input":{"command":"crash"}}]},"parent_tool_use_id":null}'
      exit 1
    fi
    fold=; [[ $line == *e2e-fold* ]] && fold=1
    if [[ $line =~ e2e-hold:([A-Za-z0-9_-]+) ]]; then hold "${BASH_REMATCH[1]}" $fold || continue; fi
    if [[ $line =~ e2e-mcp:([a-z_]+):([A-Za-z0-9+/=]+) ]]; then
      mcp "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
      result
      continue
    fi
  fi
  case "$line" in
    *'"subtype":"interrupt"'*) ack "$line" ;; # idle: no turn to end
    *set_permission_mode*) setmode "$line" ;;
    *control_re*) ;;
    *e2e-noop*'"type":"user"'*) text "Nothing to do"; result ;;
    *e2e-ask*'"type":"user"'*)
      tool "toolu_ask$RANDOM" Bash '{"command":"echo e2e-permitted >> permitted.txt","description":"Append a line, not '"${E2E_SECRET:-}"'"}' ran
      if [ -n "$ok" ]; then echo e2e-permitted >> permitted.txt; say "Ran it"; else say "Not allowed: $out"; fi
      ;;
    *e2e-plan*'"type":"user"'*)
      if [ "$mode" != plan ]; then say "Not in plan mode ($mode)"; continue; fi
      tool "toolu_plan$RANDOM" ExitPlanMode '{"plan":"1. Write plan.txt\n2. Done"}' "User approved the plan"
      if [ -n "$ok" ]; then say "Plan approved"; else say "Keep planning: $out"; fi
      ;;
    *preview*'"type":"user"'*) # keys are sorted: the prompt comes first
      mkdir -p ~/site/assets
      echo '<!doctype html><script src="/assets/app.js"></script><p>e2e-preview-page</p>' > ~/site/index.html
      echo 'console.log("e2e-preview-asset")' > ~/site/assets/app.js
      setsid python3 -m http.server 5173 -d ~/site </dev/null >/dev/null 2>&1 &
      queued
      cat <<JSON
{"type":"assistant","message":{"content":[{"type":"text","text":"Serving on :5173"}]},"parent_tool_use_id":null}
{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":10,"total_cost_usd":0,"queued_turn_count":$nq}
JSON
      ;;
    *'"type":"user"'*)
      n=$(( $(ls hello*.txt 2>/dev/null | wc -l) + 1 )); printf 'hello %s\n%s\n' "$n" "$line" > "hello$n.txt"; sleep 1
      case "$line" in *commit*) { git add -A && git commit -qm "hello $n"; } >&2 ;; esac
      # Report the image blocks and inlined text files received, for e2e.
      images=$(grep -o '"type":"image"' <<<"$line" | wc -l | tr -d ' ')
      files=$(grep -o 'Attached file ' <<<"$line" | wc -l | tr -d ' ')
      if [ "$images" -gt 0 ] || [ "$files" -gt 0 ]; then
        types=$(grep -o '"media_type":"[^"]*"' <<<"$line" | cut -d'"' -f4 | tr '\n' ' ')
        echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"Received $images image blocks (${types% }) and $files text files\"}]},\"parent_tool_use_id\":null}"
      fi
      queued
      cat <<JSON
{"type":"system","subtype":"init","session_id":"s","model":"$model"}
{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Working on it"}},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_todo_a$n","name":"TodoWrite","input":{"todos":[{"content":"Look around","status":"in_progress","activeForm":"Looking around"},{"content":"Write hello$n.txt","status":"pending","activeForm":"Writing hello$n.txt"}]}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_todo_a$n","type":"tool_result","content":"Todos have been modified successfully.","is_error":false}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_task$n","name":"Task","input":{"description":"Look around","prompt":"List the files","subagent_type":"Explore"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"type":"text","text":"List the files"}]},"parent_tool_use_id":"toolu_task$n"}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_sub$n","name":"Glob","input":{"pattern":"*"}}]},"parent_tool_use_id":"toolu_task$n"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_sub$n","type":"tool_result","content":"README\nhello$n.txt","is_error":false}]},"parent_tool_use_id":"toolu_task$n"}
{"type":"assistant","message":{"content":[{"type":"text","text":"Two files."}]},"parent_tool_use_id":"toolu_task$n"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_task$n","type":"tool_result","content":[{"type":"text","text":"There are two files: README and hello$n.txt."}]}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_bash$n","name":"Bash","input":{"command":"cat hello$n.txt","description":"Show the file"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bash$n","type":"tool_result","content":"hello $n","is_error":false}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_$n","name":"Write","input":{"file_path":"hello$n.txt","content":"hello $n\n"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_$n","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_todo_b$n","name":"TodoWrite","input":{"todos":[{"content":"Look around","status":"completed","activeForm":"Looking around"},{"content":"Write hello$n.txt","status":"completed","activeForm":"Writing hello$n.txt"}]}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_todo_b$n","type":"tool_result","content":"Todos have been modified successfully.","is_error":false}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"text","text":"Created hello$n.txt with $model · $effort"}]},"parent_tool_use_id":null}
{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":1000,"total_cost_usd":$cost,"queued_turn_count":$nq}
JSON
      ;;
  esac
done
