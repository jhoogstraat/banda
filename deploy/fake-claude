#!/bin/bash
# Fake Claude Code for tests: logged in unless `auth logout` ran, and emits
# stream-json turns like the real CLI, creating one file per prompt. Prompts
# are logged to ~/.fake-prompts.
if [ "$1" = auth ]; then
  out="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.fake-logged-out"
  case "$2" in
    status) [ ! -e "$out" ] ;;
    login) echo "Open https://claude.ai/fake-login to sign in."; rm -f "$out"; echo "Login successful." ;;
    logout) touch "$out" && echo "Successfully logged out." ;;
  esac
  exit
fi
while IFS= read -r line; do
  case "$line" in
    *control_request*) echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"interrupted","duration_ms":1}' ;;
    *'"type":"user"'*)
      echo "$line" >> ~/.fake-prompts
      n=$(( $(ls hello*.txt 2>/dev/null | wc -l) + 1 )); echo "hello $n" > "hello$n.txt"; sleep 1
      cat <<JSON
{"type":"system","subtype":"init","session_id":"s","model":"fake"}
{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Working on it"}},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_$n","name":"Write","input":{"file_path":"hello$n.txt"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_$n","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"text","text":"Created hello$n.txt"}]},"parent_tool_use_id":null}
{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":1000,"total_cost_usd":0.01}
JSON
      ;;
  esac
done
