#!/bin/bash
# Fake Claude Code for tests: logged in unless `auth logout` ran, and emits
# stream-json turns like the real CLI (`mise run contract` checks the runner
# against the real one; docs/development.md lists where this fake still
# differs), creating one file per prompt (holding the prompt's stream-json line). Replies name the --model and --effort it was
# started with, and the first line of the profile text in --append-system-prompt
# (what follows Banda's own paragraph), if there is one. A prompt that mentions "preview" starts a web server on :5173
# instead (the Browser tab). One that says "commit" also commits. "e2e-ask"
# runs a Bash command (its description holds $E2E_SECRET, for redaction) that
# asks for permission first (unless the mode bypasses), "e2e-ask-first" asks
# before it streams the call, "e2e-plan" proposes a plan in plan mode
# (ExitPlanMode); they act on the answer. e2e-ask runs the command the answer
# allowed (it may be edited), by default appending to permitted.txt;
# "e2e-cmd:<base64 command>" asks for that one instead. "e2e-question" asks two
# questions (AskUserQuestion, also in bypass mode, like the real CLI) and says
# "Answers: <the answers' JSON>". "e2e-enter-plan" enters plan mode itself
# (EnterPlanMode, which the real CLI allows without asking). Each turn plans
# with the task tools (TaskCreate, TaskUpdate), keeping the tasks in the CLI's
# files; "e2e-tasks" leaves one open. The prompt "/compact" compacts, as the
# real CLI does with its slash command.
#
# Directives a test puts anywhere in a prompt, one case each in the loop below
# (web/e2e/fixtures.ts has helpers for them):
#   e2e-echo          first says "Received: <the prompt's text>", so tests read
#                     what reached the agent from the events.
#   e2e-hold:<name>   starts the turn (init, a delta, "Holding <name>", a Bash
#                     tool call) and keeps it open until ~/e2e-release/<name>
#                     exists, then goes on with the prompt. It keeps reading
#                     stdin: messages queue, permission modes apply, and an
#                     interrupt ends the turn.
#   e2e-retry:<name>  first reports a retry (system/api_retry: overloaded,
#                     3/10) and waits, silent, until ~/e2e-release/<name> exists.
#   e2e-fold          on a held turn: the messages that arrived while it was
#                     held join the turn (each says "Folded a message into this
#                     turn", and with e2e-echo "Received: …"), and only one
#                     result follows, like the real CLI folding at a tool boundary.
#   e2e-crash:<name>  makes a tool call and exits 1 mid-turn, without a result,
#                     once per thread: a redelivered prompt runs normally.
#   e2e-cost:<usd>    the turn's result reports this total_cost_usd (default 0.01).
#   e2e-deltas:<n>    first streams n text deltas in a burst.
#   e2e-noop          replies and ends the turn, changing no file.
#   e2e-file:<path>   writes <path> instead of hello<n>.txt.
#   e2e-mcp:<tool>:<base64 JSON arguments>
#                     calls that tool of the Banda MCP server, as the agent
#                     would, and says "MCP <tool>: <result text>".
# An interrupt gets a result only while a turn runs (a hold), like the real CLI.
# Before each result it reads what was sent meanwhile, as the real CLI reads stdin
# during a turn. Each result lists the uuids of the prompts it ended
# (user_message_uuids): its own and those folded into it.
if [ "$1" = auth ]; then
  out="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.fake-logged-out"
  case "$2" in
    status) [ ! -e "$out" ] ;;
    login) echo "Open https://claude.ai/fake-login to sign in."; rm -f "$out"; echo "Login successful." ;;
    logout) touch "$out" && echo "Successfully logged out." ;;
  esac
  exit
fi
model=default effort=default profile= sid=s
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id|--resume) sid=$2; shift ;;
    --model) model=$2; shift ;;
    --effort) effort=$2; shift ;;
    --append-system-prompt) profile=$(awk 'p { print; exit } /^$/ { p = 1 }' <<<"$2"); shift ;;
  esac
  shift
done
mode=default
# The task list, a file per task, as the real CLI keeps it.
tasks="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/tasks/$sid"
# task_create <subject> <activeForm>: a TaskCreate call and its result; the id is in $task.
task_create() {
  mkdir -p "$tasks"
  task=$(( $(cat "$tasks/.highwatermark" 2>/dev/null || echo 0) + 1 ))
  echo $task > "$tasks/.highwatermark"
  jq -n --arg id $task --arg s "$1" --arg a "$2" '{id:$id,subject:$s,description:$s,activeForm:$a,status:"pending",blocks:[],blockedBy:[]}' > "$tasks/$task.json"
  jq -cn --arg id $task --arg s "$1" --arg a "$2" '{type:"assistant",message:{content:[{type:"tool_use",id:"toolu_tc\($id)",name:"TaskCreate",input:{subject:$s,description:$s,activeForm:$a}}]},parent_tool_use_id:null}'
  jq -cn --arg id $task --arg s "$1" '{type:"user",message:{role:"user",content:[{tool_use_id:"toolu_tc\($id)",type:"tool_result",content:"Task #\($id) created successfully: \($s)"}]},parent_tool_use_id:null,tool_use_result:{task:{id:$id,subject:$s}}}'
}
# task_update <id> <status>: a TaskUpdate call and its result.
task_update() {
  local from
  from=$(jq -r .status "$tasks/$1.json")
  jq --arg st "$2" '.status = $st' "$tasks/$1.json" > "$tasks/$1.tmp" && mv "$tasks/$1.tmp" "$tasks/$1.json"
  jq -cn --arg id "$1" --arg st "$2" '{type:"assistant",message:{content:[{type:"tool_use",id:"toolu_tu\($id)_\($st)",name:"TaskUpdate",input:{taskId:$id,status:$st}}]},parent_tool_use_id:null}'
  jq -cn --arg id "$1" --arg st "$2" --arg from "$from" '{type:"user",message:{role:"user",content:[{tool_use_id:"toolu_tu\($id)_\($st)",type:"tool_result",content:"Updated task #\($id) status"}]},parent_tool_use_id:null,tool_use_result:{success:true,taskId:$id,updatedFields:["status"],statusChange:{from:$from,to:$st}}}'
}
# The runner marshals maps, so keys are sorted: "request" comes before "type".
setmode() { mode=$(sed 's/.*"mode":"\([A-Za-z]*\)".*/\1/' <<<"$1"); }
# ask <tool> <tool_use id> <input json>: asks like --permission-prompt-tool stdio
# and leaves the answer's control_response line in $answer.
ask() {
  local id=perm-$RANDOM$RANDOM
  echo "{\"type\":\"control_request\",\"request_id\":\"$id\",\"request\":{\"subtype\":\"can_use_tool\",\"tool_name\":\"$1\",\"input\":$3,\"tool_use_id\":\"$2\",\"description\":\"fake asks\"}}"
  while IFS= read -r answer; do
    case "$answer" in
      *set_permission_mode*) setmode "$answer" ;;
      *control_response*) [[ $answer == *"\"$id\""* ]] && return ;;
    esac
  done
}
# tool <id> <name> <input json> <output>: a tool call and its result, after asking if needed
# (before the call is streamed if $first is set).
tool() {
  local use="{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"$1\",\"name\":\"$2\",\"input\":$3}]},\"parent_tool_use_id\":null}"
  [ -n "$first" ] || echo "$use"
  answer='"behavior":"allow"'
  { [ "$mode" = bypassPermissions ] && [ "$2" != AskUserQuestion ]; } || ask "$2" "$1" "$3"
  [ -z "$first" ] || echo "$use"
  if [[ $answer == *'"behavior":"allow"'* ]]; then
    ok=1 err=false out=$4
  else
    ok='' err=true out=$(sed 's/.*"message":"\([^"]*\)".*/\1/' <<<"$answer")
  fi
  echo "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"$1\",\"type\":\"tool_result\",\"content\":\"$out\",\"is_error\":$err}]},\"parent_tool_use_id\":null}"
}
say() {
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"$1\"}]},\"parent_tool_use_id\":null}"
  queued
  echo '{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":10,"total_cost_usd":0,"user_message_uuids":['$uuids']}'
}
# ack <control_request line>: a success control_response to it.
ack() { echo "{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"$(sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p' <<<"$1")\"}}"; }
interrupted() { queued; echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"interrupted","duration_ms":1,"terminal_reason":"aborted_tools","user_message_uuids":['$uuids']}'; }
text() { jq -cn --arg t "$1" '{type:"assistant",message:{content:[{type:"text",text:$t}]},parent_tool_use_id:null}'; }
result() { queued; echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"done\",\"duration_ms\":10,\"total_cost_usd\":$cost,\"user_message_uuids\":[$uuids]}"; }
# uuid <user line>: its uuid, quoted for a JSON list.
uuid() { jq -c '.uuid // empty' <<<"$1"; }
# prompt <user line>: its text.
prompt() { jq -r '.message.content | if type == "string" then . else map(select(.type == "text").text) | join("\n") end' <<<"$1"; }
queue=()
# next: the next line, from the messages queued during a turn first.
next() {
  if [ ${#queue[@]} -gt 0 ]; then line=${queue[0]}; queue=("${queue[@]:1}"); else IFS= read -r line; fi
}
# queued: moves the lines sent so far into the queue.
queued() {
  local l rest s
  while :; do
    IFS= read -r -t 0.05 l; s=$?
    if [ $s = 0 ]; then queue+=("$l")
    elif [ $s -gt 128 ] && [ -n "$l" ] && IFS= read -r rest; then queue+=("$l$rest") # a line cut by the timeout
    else break; fi
  done
}
# hold <name> [fold]: see e2e-hold and e2e-fold above. Fails if interrupted.
hold() {
  local l part= id=toolu_hold_$1
  echo "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"s\",\"model\":\"$model\"}"
  echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Holding"}},"parent_tool_use_id":null}'
  text "Holding $1"
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"$id\",\"name\":\"Bash\",\"input\":{\"command\":\"wait for $1\"}}]},\"parent_tool_use_id\":null}"
  until [ -e ~/e2e-release/"$1" ]; do
    IFS= read -r -t 0.2 l
    case $? in
      0) l=$part$l part= ;;
      1) exit 0 ;; # stdin closed
      *) part+=$l; continue ;; # a timeout keeps what was read of the line
    esac
    case "$l" in
      *'"subtype":"interrupt"'*)
        ack "$l"
        echo "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"$id\",\"type\":\"tool_result\",\"content\":\"interrupted\",\"is_error\":true}]},\"parent_tool_use_id\":null}"
        interrupted; return 1 ;;
      *set_permission_mode*) setmode "$l" ;;
      *control_re*) ;;
      *) queue+=("$l") ;;
    esac
  done
  echo "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"$id\",\"type\":\"tool_result\",\"content\":\"released\",\"is_error\":false}]},\"parent_tool_use_id\":null}"
  [ -n "$2" ] || return 0
  queued
  local q kept=()
  for q in "${queue[@]}"; do
    if [[ $q == *'"type":"user"'* ]]; then
      [[ $q == *e2e-echo* ]] && text "Received: $(prompt "$q")"
      text "Folded a message into this turn"
      uuids+=",$(uuid "$q")"
    else
      kept+=("$q")
    fi
  done
  queue=("${kept[@]}")
}
# mcp <tool> <base64 arguments>: see e2e-mcp above.
mcp() {
  local args out id=toolu_mcp$RANDOM
  args=$(base64 -d <<<"$2")
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"$id\",\"name\":\"mcp__banda__$1\",\"input\":$args}]},\"parent_tool_use_id\":null}"
  out=$(curl -s -X POST "$BANDA_API_URL/mcp" -H "Authorization: Bearer $BANDA_RUNNER_TOKEN" -H "X-Banda-Thread: $BANDA_THREAD_ID" \
    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
    -d "$(jq -cn --arg n "$1" --argjson a "$args" '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$n,arguments:$a}}')" |
    sed -n 's/^data: //; /^{/p' | jq -r '.result.content[0].text // .error.message // .')
  jq -cn --arg id "$id" --arg out "$out" '{type:"user",message:{role:"user",content:[{tool_use_id:$id,type:"tool_result",content:$out,is_error:false}]},parent_tool_use_id:null}'
  text "MCP $1: $out"
}
while next; do
  cost=0.01
  if [[ $line == *'"type":"user"'* ]]; then
    uuids=$(uuid "$line")
    [[ $line =~ e2e-cost:([0-9.]+) ]] && cost=${BASH_REMATCH[1]}
    if [[ $line == *e2e-echo* ]]; then
      text "Received: $(prompt "$line")"
    fi
    if [[ $line =~ e2e-deltas:([0-9]+) ]]; then
      for ((i = 0; i < BASH_REMATCH[1]; i++)); do
        echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"x"}},"parent_tool_use_id":null}'
      done
    fi
    if [[ $line =~ e2e-crash:([A-Za-z0-9_-]+) ]] && [ ! -e ~/e2e-crashed/"${BASH_REMATCH[1]}" ]; then
      mkdir -p ~/e2e-crashed && touch ~/e2e-crashed/"${BASH_REMATCH[1]}"
      echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_crash","name":"Bash","input":{"command":"crash"}}]},"parent_tool_use_id":null}'
      exit 1
    fi
    fold=; [[ $line == *e2e-fold* ]] && fold=1
    if [[ $line =~ e2e-retry:([A-Za-z0-9_-]+) ]]; then
      echo '{"type":"system","subtype":"api_retry","attempt":3,"max_retries":10,"retry_delay_ms":2049,"error_status":529,"error":"overloaded","session_id":"s"}'
      until [ -e ~/e2e-release/"${BASH_REMATCH[1]}" ]; do sleep 0.2; done
    fi
    if [[ $line =~ e2e-hold:([A-Za-z0-9_-]+) ]]; then hold "${BASH_REMATCH[1]}" $fold || continue; fi
    if [[ $line =~ e2e-mcp:([a-z_]+):([A-Za-z0-9+/=]+) ]]; then
      mcp "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
      result
      continue
    fi
  fi
  case "$line" in
    *'"subtype":"interrupt"'*) ack "$line" ;; # idle: no turn to end
    *set_permission_mode*) setmode "$line" ;;
    *control_re*) ;;
    *e2e-noop*'"type":"user"'*) text "Nothing to do"; result ;;
    *'"content":"/compact'*'"type":"user"'*)
      echo '{"type":"system","subtype":"status","status":"compacting","session_id":"s"}'
      echo '{"type":"system","subtype":"status","status":null,"compact_result":"success","session_id":"s"}'
      echo '{"type":"system","subtype":"compact_boundary","session_id":"s","compact_metadata":{"trigger":"manual","pre_tokens":15,"post_tokens":1133}}'
      echo '{"type":"user","message":{"role":"user","content":"<local-command-stdout>Compacted </local-command-stdout>"},"session_id":"s","parent_tool_use_id":null,"isReplay":true}'
      queued
      echo '{"type":"result","subtype":"success","is_error":false,"result":"","num_turns":0,"duration_ms":10,"total_cost_usd":0.01,"user_message_uuids":['$uuids']}'
      ;;
    *e2e-tasks*'"type":"user"'*)
      task_create "Read the code" "Reading the code"; a=$task
      task_create "Write the fix" "Writing the fix"; b=$task
      task_update $a completed
      task_update $b in_progress
      say "Half done"
      ;;
    *e2e-question*'"type":"user"'*)
      tool "toolu_q$RANDOM" AskUserQuestion '{"questions":[{"question":"Which database?","header":"Database","options":[{"label":"Postgres","description":"The usual"},{"label":"SQLite","description":"One file"}],"multiSelect":false},{"question":"Which extras?","header":"Extras","options":[{"label":"Cache","description":"Faster reads"},{"label":"Search","description":"Full text"}],"multiSelect":true}]}' "User has answered your questions."
      if [ -n "$ok" ]; then text "Answers: $(jq -c '.response.response.updatedInput.answers' <<<"$answer")"; else text "Not answered: $out"; fi
      result
      ;;
    *e2e-enter-plan*'"type":"user"'*)
      echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_enter","name":"EnterPlanMode","input":{}}]},"parent_tool_use_id":null}'
      mode=plan
      echo '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_enter","type":"tool_result","content":"Entered plan mode.","is_error":false}]},"parent_tool_use_id":null}'
      say "Planning now"
      ;;
    *e2e-ask*'"type":"user"'*)
      first=; [[ $line == *e2e-ask-first* ]] && first=1
      cmd='echo e2e-permitted >> permitted.txt'
      [[ $line =~ e2e-cmd:([A-Za-z0-9+/=]+) ]] && cmd=$(base64 -d <<<"${BASH_REMATCH[1]}")
      tool "toolu_ask$RANDOM" Bash "$(jq -cn --arg c "$cmd" --arg d "Append a line, not ${E2E_SECRET:-}" '{command:$c,description:$d}')" ran
      if [ -n "$ok" ]; then
        run=$(jq -r '.response.response.updatedInput.command // empty' <<<"$answer" 2>/dev/null)
        bash -c "${run:-$cmd}"; say "Ran it"
      else say "Not allowed: $out"; fi
      ;;
    *e2e-plan*'"type":"user"'*)
      if [ "$mode" != plan ]; then say "Not in plan mode ($mode)"; continue; fi
      # The model calls it with {}; the CLI adds the plan file's text and path.
      tool "toolu_plan$RANDOM" ExitPlanMode '{"plan":"1. Write plan.txt\n2. Done","planFilePath":"/home/banda/.claude/plans/e2e-plan.md"}' "User has approved your plan."
      if [ -n "$ok" ]; then say "Plan approved"; else say "Keep planning: $out"; fi
      ;;
    *preview*'"type":"user"'*) # keys are sorted: the prompt comes first
      mkdir -p ~/site/assets
      echo '<!doctype html><script src="/assets/app.js"></script><p>e2e-preview-page</p>' > ~/site/index.html
      echo 'console.log("e2e-preview-asset")' > ~/site/assets/app.js
      setsid python3 -m http.server 5173 -d ~/site </dev/null >/dev/null 2>&1 &
      queued
      cat <<JSON
{"type":"assistant","message":{"content":[{"type":"text","text":"Serving on :5173"}]},"parent_tool_use_id":null}
{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":10,"total_cost_usd":0,"user_message_uuids":[$uuids]}
JSON
      ;;
    *'"type":"user"'*)
      n=$(( $(ls hello*.txt 2>/dev/null | wc -l) + 1 )); f=hello$n.txt
      [[ $line =~ e2e-file:([A-Za-z0-9_./-]+) ]] && f=${BASH_REMATCH[1]} && mkdir -p "$(dirname "$f")"
      printf 'hello %s\n%s\n' "$n" "$line" > "$f"; sleep 1
      case "$line" in *commit*) { git add -A && git commit -qm "hello $n"; } >&2 ;; esac
      # Report the image blocks and inlined text files received, for e2e.
      images=$(grep -o '"type":"image"' <<<"$line" | wc -l | tr -d ' ')
      files=$(grep -o 'Attached file ' <<<"$line" | wc -l | tr -d ' ')
      if [ "$images" -gt 0 ] || [ "$files" -gt 0 ]; then
        types=$(grep -o '"media_type":"[^"]*"' <<<"$line" | cut -d'"' -f4 | tr '\n' ' ')
        echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"Received $images image blocks (${types% }) and $files text files\"}]},\"parent_tool_use_id\":null}"
      fi
      reply=$(text "Created hello$n.txt with $model · $effort${profile:+ · $profile}")
      queued
      cat <<JSON
{"type":"system","subtype":"init","session_id":"s","model":"$model"}
{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Working on it"}},"parent_tool_use_id":null}
JSON
      task_create "Look around" "Looking around"; a=$task
      task_create "Write hello$n.txt" "Writing hello$n.txt"; b=$task
      task_update $a in_progress
      cat <<JSON
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_agent$n","name":"Agent","input":{"description":"Look around","prompt":"List the files","subagent_type":"Explore"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"type":"text","text":"List the files"}]},"parent_tool_use_id":"toolu_agent$n"}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_sub$n","name":"Bash","input":{"command":"ls","description":"List files"}}]},"parent_tool_use_id":"toolu_agent$n"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_sub$n","type":"tool_result","content":"README\nhello$n.txt","is_error":false}]},"parent_tool_use_id":"toolu_agent$n"}
{"type":"assistant","message":{"content":[{"type":"text","text":"Two files."}]},"parent_tool_use_id":"toolu_agent$n"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_agent$n","type":"tool_result","content":[{"type":"text","text":"There are two files: README and hello$n.txt."}]}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_bash$n","name":"Bash","input":{"command":"cat hello$n.txt","description":"Show the file"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bash$n","type":"tool_result","content":"hello $n","is_error":false}]},"parent_tool_use_id":null}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_$n","name":"Write","input":{"file_path":"hello$n.txt","content":"hello $n\n"}}]},"parent_tool_use_id":null}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_$n","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null}
JSON
      task_update $a completed
      task_update $b completed
      cat <<JSON
$reply
{"type":"result","subtype":"success","is_error":false,"result":"done","duration_ms":1000,"total_cost_usd":$cost,"user_message_uuids":[$uuids]}
JSON
      ;;
  esac
done
